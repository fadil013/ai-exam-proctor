# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env — it is gitignored.

# Supabase (backend persistence — privileged inserts)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vision LLM — Groq takes priority over Gemini if both are set.
# Free Groq key: https://console.groq.com  →  API Keys
GROQ_API_KEY=

# Gemini fallback (free tier). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
